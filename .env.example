# Copy to .env and fill in. Never commit .env.

# Sepolia deployment (hardhat --network sepolia)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=

# Optional auction parameters for scripts/deploy.js (defaults shown)
# TOKEN_NAME=Launch Token
# TOKEN_SYMBOL=LCH
# TOKEN_SUPPLY=100          # whole tokens
# START_PRICE_ETH=2.9       # ETH per whole token at step 0
# RESERVE_PRICE_ETH=1.0     # ETH per whole token at the last step
# STEP_SECONDS=60           # must divide 1200
# MIN_BID_ETH=0.01
# START_AUCTION=true
