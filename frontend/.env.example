# Copy to frontend/.env.local to override the defaults.
# RPC used for read-only data. Restart `npm run frontend` after changing it.
VITE_RPC_URL=http://127.0.0.1:8545

# Sepolia: use a public RPC or Infura. Free-tier Alchemy limits eth_getLogs to 10 blocks
# and the web app fails with "missing revert data". See README "Deploy to Sepolia".
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
